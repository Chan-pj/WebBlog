<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ylove.mapper.PostMapper">

    <resultMap id="postMap" type="com.ylove.vo.PostVO">
        <id property="postId" column="post_id"/>
        <result property="blogId" column="blog_id"/>
        <result property="boardId" column="board_id"/>
        <result property="parentPostId" column="parent_post_id"/>
        <result property="writerUserId" column="writer_user_id"/>
        <result property="title" column="title"/>
        <result property="content" column="content"/>
    </resultMap>

    <insert id="insertPost" parameterType="com.ylove.vo.PostVO" useGeneratedKeys="true" keyProperty="postId">
        INSERT INTO post (blog_id, board_id, parent_post_id, writer_user_id, title, content)
        VALUES (#{blogId}, #{boardId}, #{parentPostId}, #{writerUserId}, #{title}, #{content})
    </insert>

    <update id="updatePost" parameterType="com.ylove.vo.PostVO">
        UPDATE post
        SET title = #{title},
            content = #{content}
        WHERE post_id = #{postId}
    </update>

    <delete id="deletePost" parameterType="long">
        DELETE FROM post WHERE post_id = #{postId}
    </delete>

    <select id="selectPostById" parameterType="long" resultMap="postMap">
        SELECT * FROM post WHERE post_id = #{postId}
    </select>

    <select id="selectRootPostsByBoardId" parameterType="long" resultMap="postMap">
        SELECT * FROM post
        WHERE board_id = #{boardId}
          AND parent_post_id IS NULL
        ORDER BY post_id DESC
    </select>

    <select id="selectRepliesByParentPostId" parameterType="long" resultMap="postMap">
        SELECT * FROM post
        WHERE parent_post_id = #{parentPostId}
        ORDER BY post_id ASC
    </select>

</mapper>